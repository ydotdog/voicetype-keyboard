OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

DATABASE_PATH=./voicetype.sqlite3
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=voicetype

# For production this should be the bundle id or Services ID used as the Apple token audience.
APPLE_CLIENT_ID=com.kyleqi.voicetype
APPLE_AUTH_DEV_BYPASS=false

# StoreKit transaction JWS signature verification is intentionally strict for production.
# Keep true only for local StoreKit testing until App Store Server API verification is wired.
ALLOW_UNVERIFIED_STOREKIT_JWS=true
ALLOW_DEV_CREDIT=false

# Audio-token fallback used only when the OpenAI response does not include token usage.
FALLBACK_AUDIO_TOKENS_PER_SECOND=50
COST_MARKUP_BPS=0
