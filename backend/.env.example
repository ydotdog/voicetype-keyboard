OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_PROVIDER_ACCOUNT_ID=openai-primary

# Production should use Postgres. If DATABASE_URL is empty, the API falls back
# to SQLite for local development only.
DATABASE_URL=
# DATABASE_URL=postgresql://voicetype:change-me@localhost:5432/voicetype
DATABASE_PATH=./voicetype.sqlite3
DATABASE_POOL_MAX_SIZE=10

JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=voicetype
JWT_TTL_DAYS=365

# For production this should be the bundle id or Services ID used as the Apple token audience.
APPLE_CLIENT_ID=com.kyleqi.voicetype
APPLE_BUNDLE_ID=com.kyleqi.voicetype
APPLE_APP_APPLE_ID=
APPLE_AUTH_DEV_BYPASS=false

# Sign in with Apple server-to-server credentials.
# Required for App Store Guideline 5.1.1(v): when a user deletes their account,
# the backend revokes the Apple token grant. Without these, deletion still works
# but the Apple token is not revoked. Create the key in the Apple Developer portal
# (Certificates, Identifiers & Profiles -> Keys -> enable "Sign in with Apple").
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
# Provide the .p8 private key via exactly one of the following:
#   APPLE_SIGNIN_PRIVATE_KEY      - PEM contents inline (use \n for newlines)
#   APPLE_SIGNIN_PRIVATE_KEY_B64  - base64 of the whole .p8 file
#   APPLE_SIGNIN_PRIVATE_KEY_PATH - path to the .p8 file on disk
APPLE_SIGNIN_PRIVATE_KEY=
APPLE_SIGNIN_PRIVATE_KEY_B64=
APPLE_SIGNIN_PRIVATE_KEY_PATH=
# Override only for testing against Apple's endpoints.
# APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
# APPLE_REVOKE_URL=https://appleid.apple.com/auth/revoke

# StoreKit transaction JWS signature verification is strict by default.
APPLE_STOREKIT_ENVIRONMENT=PRODUCTION
STOREKIT_VERIFICATION_MODE=strict
ALLOW_UNVERIFIED_STOREKIT_JWS=false
REQUIRE_STOREKIT_APP_ACCOUNT_TOKEN=true
APPLE_ROOT_CERTIFICATE_PATHS=/secure/path/AppleRootCA-G3.cer
APPLE_ROOT_CERTIFICATE_PEMS_B64=

# Local development only.
ALLOW_DEV_CREDIT=false
DEV_CREDIT_SHARED_SECRET=
DEV_CREDIT_MAX_USD_MICROS=20000000

# One-time welcome credit granted on first sign-in. Gives App Review and new
# users something to transcribe without a purchase. 100000 micros = 0.10 USD =
# 100,000 credits. Set SIGNUP_GRANT_ENABLED=false to disable.
SIGNUP_GRANT_ENABLED=true
SIGNUP_GRANT_USD_MICROS=100000

# Audio-token fallback used only when the OpenAI response does not include token usage.
FALLBACK_AUDIO_TOKENS_PER_SECOND=50

# Retail billing defaults to standard App Store commission plus 20% profit:
# 1.20 / (1 - 0.30) = 1.7143x raw OpenAI model cost.
APPLE_COMMISSION_BPS=3000
TARGET_PROFIT_MARGIN_BPS=2000
COST_MARKUP_BPS=7143
MAX_AUDIO_BYTES=25165824
